# ──────────────────────────────────────────────────────────────────────────────
# Environment variables template — France Live Weather Pipeline
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (already gitignored) and set your values.
# The defaults below are for LOCAL DEVELOPMENT ONLY.
# ⚠️  Change all passwords and secret keys before any production deployment.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL — main weather database
POSTGRES_DB=db
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password          # CHANGE IN PRODUCTION

# Airflow metadata database (created automatically by airflow_init.sql)
# Connection string format: postgresql+psycopg2://user:pass@host:port/db
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@db:5432/airflow_db

# Superset
SUPERSET_SECRET_KEY=change-me-in-production-use-a-random-256-bit-key
DATABASE_DB=superset_db
DATABASE_USER=superset
DATABASE_PASSWORD=superset             # CHANGE IN PRODUCTION
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DIALECT=postgresql+psycopg2

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Logging
SUPERSET_LOG_LEVEL=info
